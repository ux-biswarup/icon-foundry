{
  "$schema": "../language.schema.json",
  "id": "lucide-inspired",
  "name": "Lucide-inspired",
  "version": "0.3.0",
  "description": "A hand-authored starter language following the principles of Lucide: 24px canvas, 1.5px round strokes, 2px safe area, low detail, plus 16px and 32px optical sizes. Use it as a template for your own language.",
  "canvas": 24,
  "grid": 1,
  "safeArea": 2,
  "stroke": {
    "width": 1.5,
    "cap": "round",
    "join": "round"
  },
  "cornerRadius": 2,
  "style": {
    "default": "outline",
    "allowed": ["outline", "filled"]
  },
  "colors": {
    "allowed": ["currentColor"]
  },
  "detail": "low",
  "limits": {
    "maxElements": 4,
    "maxShapes": 12
  },
  "minNegativeSpace": 2,
  "sizes": [
    {
      "canvas": 16,
      "safeArea": 1,
      "stroke": { "width": 1.25 },
      "cornerRadius": 1.5,
      "limits": { "maxElements": 3, "maxShapes": 8 },
      "minNegativeSpace": 1.5
    },
    {
      "canvas": 32,
      "safeArea": 3,
      "stroke": { "width": 2.5 },
      "cornerRadius": 2.5,
      "limits": { "maxElements": 5, "maxShapes": 16 },
      "minNegativeSpace": 2.5
    }
  ]
}
